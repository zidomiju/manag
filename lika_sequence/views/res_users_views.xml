<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_initials" model="ir.ui.view">
        <field name="name">res.users.form.inherit.initials</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook[@colspan='4']" position="before">
                <!-- <h5 name="h5_phone" class="d-flex align-items-baseline mb-0">
                    <i class="fa fa-fw fa-user me-1 text-primary" title="Initials"/>
                    </h5> -->
                <separator string="ADDITIONAL INFORMATIONS" />
                <group>
                    <field name="initials" placeholder="User Initials, e.g. LK. Max 2 characters."/>
                </group>

                <separator string="OPTIONS" />
            </xpath>
        </field>
    </record>

