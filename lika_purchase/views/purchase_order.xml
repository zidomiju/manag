<?odoo version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_custom_purchase" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='reminder']" position="after">
                <field name="delivery_address"/>
                <field name="project_number"/>
            </xpath>
        </field>

    </record>

    <record id="purchase_order_form_add_custom_print"
            model="ir.ui.view">

        <field name="name">
            purchase.order.form.add.custom.print
        </field>

        <field name="model">purchase.order</field>

        <field name="inherit_id"
               ref="purchase.purchase_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//header/button[@name='button_confirm']"
                   position="after">

                <button name="action_print_custom_purchase_order"
                        type="object"
                        string="Print PO"
                        class="btn-secondary"
                        groups="purchase.group_purchase_user"/>

            </xpath>

        </field>
    </record>


    <record id="purchase_order_hide_default_print"
            model="ir.ui.view">
        <field name="name">purchase.order.hide.default.print</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header/button[@name='print_quotation']"
                   position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

        </field>
    </record>

</odoo>