<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_crane_model_list" model="ir.ui.view">
        <field name="name">crane.model.list</field>
        <field name="model">crane.model</field>
        <field name="arch" type="xml">
            <list string="Master Crane Models">
                <field name="crane_model"/>
                <field name="make_id"/>
                <field name="make_code"/>
                <field name="type"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_crane_model_form" model="ir.ui.view">
        <field name="name">crane.model.form</field>
        <field name="model">crane.model</field>
        <field name="arch" type="xml">
            <form string="Master Crane Model">
                <sheet>
                    <!-- Title section directly under sheet -->
                    <div class="oe_title">
                        <label for="crane_model" string="Crane Model"/>
                        <h1>
                            <field name="crane_model" placeholder="Enter crane model name..."/>
                        </h1>
                    </div>

                    <!-- Image avatar floats directly under sheet -->
                    <field name="image_1920" widget="image" options="{'size': [200, 200]}" />

                    <group>
                        <field name="status" widget="radio" options="{'horizontal': True}"/>

                        <!-- general information section -->
                        <separator string="GENERAL INFORMATION" />
                        <field name="make_id" 
                            string="Make" 
                            required="1"
                            options="{'no_quick_create': True}"
                            placeholder="Select or type new make..."/>
                        <field name="make_code" 
                            string="Make Code"
                            placeholder="Auto filled when make is selected."/>
                        <field name="type_id" 
                            string="Type" 
                            required="1"
                            placeholder="Select or type new crane type..."/>
                        <field name="model_code"/>
                        <field name="model_year"/>
                        <field name="description"/>

                        <!-- technical specification section -->
                        <separator string="TECHNICAL SPECIFICATIONS" />
                        <field name="lifting_capacity" />
                        <field name="max_outreach" />
                        <field name="min_outreach" />
                        <field name="operating_pressure" />
                        <field name="power_source" />
                    </group>

                    <separator string="DOCUMENTS" />
                    <field name="document_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="document_filename" invisible="1" optional="hide"/>
                            <field name="document_data" filename="document_filename" widget="binary" string="Upload"/>
                            <button name="action_view_document_file" type="object" string="View" icon="fa-eye"
                                        class="btn btn-primary btn-sm"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_crane_model" model="ir.actions.act_window">
        <field name="name">Crane Models</field>
        <field name="res_model">crane.model</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
