<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Quick create form for crane.document -->
        <record id="view_crane_document_form" model="ir.ui.view">
            <field name="name">crane.document.form</field>
            <field name="model">crane.document</field>
            <field name="arch" type="xml">
                <form string="Crane document">
                    <sheet>
                        <group>
                            <field name="name" />
                            <label for="document_data" string="Document"/>
                            <div class="o_row">
                                <field name="document_data" filename="document_filename" widget="binary"/>
                                <button name="action_view_document_file" type="object" string="View" icon="fa-eye"
                                        class="btn btn-primary btn-sm"/>
                            </div>
                            <field name="document_filename" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List view for crane.document -->
        <record id="view_crane_document_list" model="ir.ui.view">
            <field name="name">crane.document.list</field>
            <field name="model">crane.document</field>
            <field name="arch" type="xml">
                <list string="Crane documents">
                    <field name="name" />
                    <field name="document_filename" invisible="1" optional="hide"/>
                    <field name="document_data" filename="document_filename" />
                </list>
            </field>
        </record>

        <!-- Search view for crane.document -->
        <record id="view_crane_document_search" model="ir.ui.view">
            <field name="name">crane.document.search</field>
            <field name="model">crane.document</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />   
                    <field name="document_filename" invisible="1"/>
                </search>
            </field>
        </record>

        <!-- Action for crane.document -->
        <record id="action_crane_document" model="ir.actions.act_window">
            <field name="name">Crane Documents</field>
            <field name="res_model">crane.document</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>