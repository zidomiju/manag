                                            readonly="1"
                                            force_save="1"

                                        />
                                        <field
                                            name="item_detail"
                                            string="ITEM DETAIL"
                                            readonly="1"
                                            class="o_item_detail"
                                            force_save="1"

                                        />
                                        <field
                                            name="condition"
                                            string="Condition"
