                                        />
                                </list>
                            </field>
                        </page>
                            
                        <page string="Part 6">
                            <h1 class="fw-bold border-bottom border-2 pb-2">Part 6.0 - HOIST(S) AND SLEW MACHINERY</h1>
                            <field 
