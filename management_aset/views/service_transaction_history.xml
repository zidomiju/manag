<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="service_transaction_history_view_list" model="ir.ui.view">
        <field name="name">service.transaction.history.view.list</field>
        <field name="model">service.transaction.history</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="serial_number"/>
                <field name="customer_id"/>
                <field name="vessel_platform_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="service_transaction_history_view_form" model="ir.ui.view">
        <field name="name">service.transaction.history_view_form</field>
        <field name="model">service.transaction.history</field>
        <field name="arch" type="xml">
            <form string="" create="0">
                <sheet>
                    
                    <group col="3">
                        <group>
                            <field name="image_crane" widget="image" options="{'size':[170,170]}" nolabel="1"/>
                        </group>
                        <group>
                            <field name="serial_number"/>
                            <field name="make"/>
                            <field name="model_id" options="{'no_open':True}"/>
                            <field name="type_crane"/>
                        </group>

                        <group>
                            <field name="vessel_platform_id"/>
                            <field name="customer_id"/>
                            <field name="country_id" options="{'no_open':True}"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Service and Maintenance History">
                            <field name="service_maintenance_history_ids" class="service_maintenance">
                                <list
                                    create="1"
                                    edit="1"
                                    delete="1">
                                        <field name="date"/>
                                        <field name="service_type_id"/>
                                        <field name="service_provider"/>
                                        <field name="next_inspection"/>
                                        <field name="notes"/>
                                </list>
                            </field>
                        </page>

                        <page string="Inspection History">
                            <field name="unit_condition_ids" class="inspection-history">
                                <list>
                                    <field name="employee_id" widget="many2many_tags"/>
                                    <field name="job_no"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>

                        <page string="Dokumenct Upload">
                            <field name="document_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="file"/>
                                    <button
                                        name="action_view_file"
                                        type="object"
                                        string="View"
                                        icon="fa-eye"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>

                  
                </sheet>
            </form>
        </field>
    </record>
</odoo>