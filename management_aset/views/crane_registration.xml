<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crane_registration_view_list" model="ir.ui.view">
        <field name="name">crane.registration.view.list</field>
        <field name="model">crane.registration</field>
        <field name="arch" type="xml">
            <list>
                <field name="make_code"/>
                <field name="make"/>
                <field name="model_id"/>
                <field name="notes"/>
                <field name="type_crane"/>
                <field name="serial_number"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="crane_registration_view_kanban" model="ir.ui.view">
        <field name="name">crane.registration.view.kanban</field>
        <field name="model">crane.registration</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="make"/>
                <field name="model_id"/>
                <field name="serial_number"/>
                <field name="customer_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_record p-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 fw-bold" style="font-size:15px;">
                                        <field name="model_id"/>
                                        <span>-</span>
                                        <field name="serial_number"/>
                                    </div>

                                    <div style="margin-bottom:4px;margin-top:3px;">
                                        <field name="make"/>
                                    </div>
                                        
                                    <div class="d-flex align-items-center gap-2">
                                        <field name="customer_id" widget="many2one_avatar_user"/>
                                        <field name="customer_id"/>
                                    </div>
                                </div>


                                <div class="ms-3">
                                    <field name="image_crane" widget="image" options="{'size':[60,60]}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="crane_registration_view_form" model="ir.ui.view">
        <field name="name">crane.registration.view.form</field>
        <field name="model">crane.registration</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <label for="crane_name"/>
                            <h1><field name="crane_name"/></h1>
                        </div>

                        <div class="o_kanban_image">
                            <field name="image_crane" widget="image" class="o_field_widget oe_field_image oe_avatar"/>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center mb-2">
                        <label for="status" class="fw-bold mb-2 me-4" style="white-space:nowrap;"/>
                        <field name="status" widget="radio" options="{'horizontal':true}"/>
                    </div>


                    <group string="General Information">
                        <field name="serial_number"/>
                        <field name="model_id"/>
                        <field name="make"/>
                        <field name="type_crane"/>
                        <field name="make_code"/>
                        <field name="year_built"/>
                        <field name="notes"/>
                    </group>

                    <group string="Customer and Location">
                        <field name="customer_id"/>
                        <field name="vessel_platform_id"
                               domain="[('current_owner_id','=',customer_id)]"
                               readonly="not customer_id"/>
                        <field name="type_asset"/>
                        <field name="installation_year"/>
                    </group>

                    <notebook>
                        <page string="Documents">
                            <field name="document_ids">
                                <list
                                    editable="bottom"
                                    create="1"
                                    delete="1"
                                    edit="1">
                                    <field name="name"/>
                                    <field name="file"/>
                                    <button
                                        name="action_view_file"
                                        type="object"
                                        string="View"
                                        icon="fa-eye"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Crane Model Documents">
                            <field name="document_model_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="document_data" widget="binary" string="Upload"/>
                                    <button name="action_view_document_file" type="object" string="View" icon="fa-eye"
                                        class="btn btn-primary btn-sm"/>

                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </chatter>
            </form>
        </field>
    </record>
</odoo>