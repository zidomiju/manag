<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Extend the Supplierinfo List View -->
    <record id="product_supplierinfo_list_view_warranty" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.warranty</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <!-- Add Warranty Note and File Upload after Lead Time (delay) -->
            <xpath expr="//field[@name='delay']" position="after">
                <field name="warranty_note" placeholder="Garansi resmi..."/>
                <field name="warranty_filename" invisible="1"/>
                <field name="warranty_file" filename="warranty_filename" widget="binary" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- 2. Extend the Supplierinfo Popup Form View -->
    <record id="product_supplierinfo_form_view_warranty" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.warranty</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='vendor']/div" position="after">
                <field name="warranty_note"/>

                <label for="warranty_file" string="Warranty"/>
                <div class="o_row">
                    <field name="warranty_file" filename="warranty_filename" widget="binary"/>
                    <button name="action_view_warranty_file" type="object" string="View" icon="fa-eye"
                            class="btn btn-primary btn-sm"/>
                </div>
                <field name="warranty_filename" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>