    <record id="seq_verification_order" model="ir.sequence">
        <field name="name">Verification Order</field>
        <field name="code">lika.verification.order</field>
        <field name="prefix">LK-%(user_initials)s-%(y)s%(range_month)s-</field>
        <field name="padding">4</field>
        <field name="use_date_range" eval="True" />
        <field name="range_reset">yearly</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
