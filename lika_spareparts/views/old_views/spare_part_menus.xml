<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Window Action: Spare Parts -->
    <record id="action_spare_part" model="ir.actions.act_window">
        <field name="name">Spare Parts</field>
        <field name="res_model">spare.part</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Spare Part record
            </p>
        </field>
    </record>

    <!-- Window Action: Categories -->
    <record id="action_spare_part_category" model="ir.actions.act_window">
        <field name="name">Part Categories</field>
        <field name="res_model">spare.part.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Main App Root Menu -->
    <!-- <menuitem id="menu_spare_part_root"
              name="Spare Parts"
              web_icon="lika_spareparts,static/description/icon.png"
              sequence="10"/> -->

    <!-- Sub-menu: Configuration -->
    <!-- <menuitem id="menu_spare_part_config"
              name="Configuration"
              parent="menu_spare_part_root"
              sequence="100"/> -->

    <!-- Add Spare Parts submenu to Inventory -> Products -->
    <menuitem id="menu_spare_part_product_inventory_main"
              name="Spare Parts"
              parent="stock.menu_stock_inventory_control"
              action="action_spare_part"
              sequence="50"/>

    <menuitem id="menu_spare_part_product_inventory_category"
              name="Spare Parts Categories"
              parent="stock.menu_stock_inventory_control"
              action="action_spare_part_category"
              sequence="60"/>
    <!--  -->



    <!-- Add Spare Parts submenu to Sale -> Products -->
    <menuitem id="menu_spare_part_product_sale_main"
              name="Spare Parts"
              parent="sale.product_menu_catalog"
              action="action_spare_part"
              sequence="50"/>

    <menuitem id="menu_spare_part_product_sale_category"
              name="Spare Parts Categories"
              parent="sale.product_menu_catalog"
              action="action_spare_part_category"
              sequence="60"/>
    <!--  -->



    <!-- Add Spare Parts submenu to Purchase -> Products -->
    <menuitem id="menu_spare_part_product_purchase_main"
              name="Spare Parts"
              parent="purchase.menu_purchase_products"
              action="action_spare_part"
              sequence="50"/>

    <menuitem id="menu_spare_part_product_purchase_category"
              name="Spare Parts Categories"
              parent="purchase.menu_purchase_products"
              action="action_spare_part_category"
              sequence="60"/>
    <!--  -->
</odoo>