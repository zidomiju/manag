<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_order_form_inherit_sale_stock_inherit" model="ir.ui.view">
    <field name="name">sale.order.form.sale.stock.inherit</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='effective_date']" position="before">
        <field name="delivery_time" />
      </xpath>
      <xpath expr="//group[@name='sales_person']" position="inside">
        <field name="partner_bank_id" />
      </xpath>
    </field>
  </record>

  <record id="view_order_form_inherit" model="ir.ui.view">
    <field name="name">sale.order.view.form.inherit</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='order_details']" position="inside">
        <field name="delivery_point_id" readonly="state == 'sale'" />
        <field name="project_name" readonly="state == 'sale'" />
        <field name="contract_number" readonly="state == 'sale'" />
        <field name="po_customer_number" readonly="state == 'sale'" />
      </xpath>
      <xpath expr="//group[@name='partner_details']" position="inside">
        <field name="no_proforma_invoice" readonly="1" />
      </xpath>

      <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
          <field name="qty_delivered" optional="hide"/>

          <field name="product_uom_id" optional="hide"/>
          <field name="delivery" optional="hide"/>
      </xpath>

      <xpath expr="//field[@name='order_line']/list/field[@name='tax_ids']" position="after">
          <field name="discount" optional="hide"/>
      </xpath>

      <xpath expr="//notebook/page[@name='other_information']" position="after"> 
          <page string="Customer Signature">
              <group>
                  <field name="signed_by"/>
                  <field name="signed_on"/>
                  <field name="signature" widget="image"/>
              </group>
          </page>
      </xpath>

    </field>
  </record>

</odoo>
