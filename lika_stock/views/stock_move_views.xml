<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_picking_form_inherit_dimension_lika_stock" model="ir.ui.view">
    <field name="name">stock.move.view.picking.form.dimension.inherit</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']" position="before">
        <field name="dimension"/>
      </xpath>
    </field>
  </record>

</odoo>
