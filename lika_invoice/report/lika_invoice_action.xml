<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account.account_invoices" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_lika_report_invoice" model="ir.actions.report">
        <field name="name">Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lika_invoice.lika_invoice_report</field>
        <field name="report_file">lika_invoice.lika_invoice_report</field>
        <field name="print_report_name">object.name</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="lika_invoice.report_invoice_paperformat"/>
    </record>


    <record id="action_lika_report_kwitansi" model="ir.actions.report">
        <field name="name">Kwitansi</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lika_invoice.lika_kwintansi_report</field>
        <field name="report_file">object.name</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="lika_invoice.report_kwintansi_paperformat"/>
    </record>
</odoo>