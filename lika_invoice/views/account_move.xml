<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_move_from_inherit_contract_number" model="ir.ui.view">
        <field name="name">account.move.custom.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='kwitansi_note']" position="after">
                <field name="no_po_so"/>
                <field name="no_contract"/>
            </xpath>

            <xpath expr="//page[@name='other_info']//group[.//field[@name='invoice_source_email']]" position="after">
                <group string="Kwitansi">
                    <field name="payment_for"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>